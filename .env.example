# Copie este ficheiro para ".env" e preencha os valores. Nunca partilhe o .env.

# Chave da Google Places API (New) — ver README, secção 3.1
GOOGLE_PLACES_API_KEY=

# Chave da API da Anthropic — ver README, secção 3.2
ANTHROPIC_API_KEY=

# Caminho para o ficheiro JSON da conta de serviço (recomendado),
# ou o conteúdo JSON completo numa só linha — ver README, secção 3.3
GOOGLE_SERVICE_ACCOUNT_JSON=./credenciais/conta-servico.json

# ID da Google Sheet (a parte do URL entre /d/ e /edit)
SHEET_ID=
